{
  "name": "credit-chess-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Credit Chess Windows test build",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.ae6820dc.creditchess",
    "productName": "Credit Chess",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
